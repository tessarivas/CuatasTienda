// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id             Int       @id @default(autoincrement())
  name           String
  cellphone      String?
  currentBalance Decimal   @default(0) @db.Decimal(10, 2)
  Layaway        Layaway[]
  Payment        Payment[]
  Sale           Sale[]
}

model Layaway {
  id          Int           @id @default(autoincrement())
  clientId    Int
  status      LayawayStatus @default(Activo)
  createdAt   DateTime      @default(now())
  Client      Client        @relation(fields: [clientId], references: [id])
  LayawayItem LayawayItem[]
}

// Cada renglón "+ apartado" de la cuenta del cliente. No se borra al liquidar
// ni al quitarlo: cambia `status` (Liquidado / Cancelado), para que el
// historial pueda mostrarse como la lista en papel. Toda reserva vigente es
// un item con status = Activo — cualquier conteo de reservas DEBE filtrar por
// ese status, o los items ya vendidos/cancelados descuadran la disponibilidad.
model LayawayItem {
  id         Int           @id @default(autoincrement())
  layawayId  Int
  productId  Int
  price      Decimal       @db.Decimal(10, 2)
  status     LayawayStatus @default(Activo)
  createdAt  DateTime      @default(now())
  // Cuándo se liquidó o canceló; null mientras sigue Activo.
  resolvedAt DateTime?
  // Venta que lo liquidó. Una Sale sin items ligados es de antes de este
  // cambio (los items se borraban) — el historial la trata distinto.
  saleId     Int?
  Layaway    Layaway       @relation(fields: [layawayId], references: [id])
  Product    Product       @relation(fields: [productId], references: [id])
  Sale       Sale?         @relation(fields: [saleId], references: [id])

  @@index([productId, status])
}

model Payment {
  id         Int           @id @default(autoincrement())
  clientId   Int
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod @default(Efectivo)
  kind       PaymentKind   @default(Abono)
  date       DateTime      @default(now())
  receivedBy String        @db.Uuid
  // Comprobante (imagen en Cloudinary) para tarjeta/transferencia. Se
  // adjunta en el Corte de Caja, no al cobrar; null = pendiente o efectivo.
  receiptUrl String?
  Client     Client        @relation(fields: [clientId], references: [id])
  User       User          @relation(fields: [receivedBy], references: [id])
}

model Product {
  id                       Int                        @id @default(autoincrement())
  title                    String
  price                    Decimal                    @db.Decimal(10, 2)
  status                   String
  createdAt                DateTime                   @default(now())
  code                     String?                    @unique
  picture                  String?
  quantity                 Int?
  soldCount                Int                        @default(0)
  supplierId               Int?
  type                     ProductType
  LayawayItem              LayawayItem[]
  Supplier                 Supplier?                  @relation(fields: [supplierId], references: [id])
  SaleItem                 SaleItem[]
  StockMovement            StockMovement[]
  // Servicios que se hacen por pedido (instalaciones, mantenimientos): son
  // los que aparecen al crear un pedido de servicio. Los rápidos (copias)
  // se venden en caja como siempre. Sólo aplica a type = SERVICE.
  byOrder                  Boolean                    @default(false)
  ServiceOrderItem         ServiceOrderItem[]
  SupplierPromotionProduct SupplierPromotionProduct[]
}

// Bitácora de entradas y salidas de inventario que NO son ventas: altas de
// mercancía y retiros (merma, devolución al proveedor, daño). `Product.quantity`
// sólo guarda el saldo actual, así que sin esta tabla el historial no se puede
// reconstruir.
model StockMovement {
  id         Int               @id @default(autoincrement())
  productId  Int
  type       StockMovementType
  quantity   Int // Siempre positivo; el signo lo da `type`.
  reason     String?
  // Nombre de quien recoge físicamente la mercancía (repartidor, transportista).
  // Sólo aplica a `Retiro` — en `Alta` no hay nadie que "recoja" nada, entra
  // mercancía. Texto libre: no hay catálogo de repartidores.
  pickedUpBy String?
  createdAt  DateTime          @default(now())
  createdBy  String            @db.Uuid
  Product    Product           @relation(fields: [productId], references: [id])
  User       User              @relation(fields: [createdBy], references: [id])

  @@index([productId, createdAt])
}

// Una venta: de la caja (clientId null) o la liquidación de apartados de un
// cliente. total = Σ (finalPrice × quantity − discount) de sus items − discount.
model Sale {
  id            Int            @id @default(autoincrement())
  // DDMMYY-NNN: fecha (hora del Pacífico, la tienda está en Baja California) +
  // consecutivo del día, compartido por
  // caja y liquidaciones. Lo genera lib/sales/folio.ts. Nullable sólo para
  // ventas anteriores a esta columna; toda venta nueva lo lleva.
  folio         String?        @unique
  total         Decimal        @db.Decimal(10, 2)
  // Descuento al total del ticket. Sólo se permite con productos de un solo
  // proveedor (la tienda no reparte descuentos entre proveedores), así que
  // siempre se le carga completo a ese proveedor.
  discount      Decimal        @default(0) @db.Decimal(10, 2)
  // null = liquidación de apartados (se paga con el saldo del cliente).
  paymentMethod PaymentMethod?
  // Comprobante (imagen en Cloudinary) para tarjeta/transferencia. Se
  // adjunta en el Corte de Caja, no al cobrar; null = pendiente o efectivo.
  receiptUrl    String?
  date          DateTime       @default(now())
  userId        String         @db.Uuid
  clientId      Int?
  Client        Client?        @relation(fields: [clientId], references: [id])
  User          User           @relation(fields: [userId], references: [id])
  SaleItem      SaleItem[]
  LayawayItem   LayawayItem[]
  // Pedido de servicio que se cobró con esta venta (si viene de uno).
  ServiceOrder  ServiceOrder?
}

model SaleItem {
  id          Int                @id @default(autoincrement())
  saleId      Int
  productId   Int
  // Precio unitario pactado (snapshot), no el precio actual del producto.
  finalPrice  Decimal            @db.Decimal(10, 2)
  quantity    Int                @default(1)
  // Descuento aplicado a esta línea (en pesos, ya calculado).
  discount    Decimal            @default(0) @db.Decimal(10, 2)
  // Descripción propia del renglón (p. ej. "Mantenimiento laptop HP") cuando
  // viene de un pedido de servicio; null = se muestra el nombre del producto.
  description String?
  // Promoción del proveedor que dio el descuento de este renglón (si aplicó
  // una; con descuento manual queda null).
  promotionId Int?
  Promotion   SupplierPromotion? @relation(fields: [promotionId], references: [id])
  Product     Product            @relation(fields: [productId], references: [id])
  Sale        Sale               @relation(fields: [saleId], references: [id])
}

model Supplier {
  id                Int                 @id @default(autoincrement())
  name              String
  businessName      String?
  cellphone         String?
  email             String?
  logo              String?
  cutoffDay         Int?
  createdAt         DateTime            @default(now())
  Product           Product[]
  // Letras del folio de sus pedidos de servicio (CO → CO-001). null = se
  // calculan del nombre (lib/services/folio.ts).
  servicePrefix     String?
  ServiceOrder      ServiceOrder[]
  SupplierPromotion SupplierPromotion[]
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String
  email               String                @unique
  role                String
  createdAt           DateTime              @default(now())
  Payment             Payment[]
  Sale                Sale[]
  StockMovement       StockMovement[]
  CashClosing         CashClosing[]
  ServiceOrder        ServiceOrder[]
  ServiceOrderPayment ServiceOrderPayment[]
  SupplierPromotion   SupplierPromotion[]
}

// Corte de caja: uno por día de la tienda (hora del Pacífico). Cubre los
// cobros desde el cierre anterior (periodStart) hasta el momento de cerrar
// (periodEnd): lo cobrado después de cerrar cae solo en el corte siguiente.
// Guarda el resumen del periodo, el efectivo contado y la diferencia. Es de
// admin: se puede corregir después de cerrado (se recalcula dentro de la
// misma ventana; updatedAt marca la corrección).
model CashClosing {
  id           Int      @id @default(autoincrement())
  // Día de la tienda en que se cerró (sin hora). Único: un corte por día.
  date         DateTime @unique @db.Date
  // Ventana de cobros [periodStart, periodEnd). periodStart = periodEnd del
  // corte anterior (o inicio del día si no hay); periodEnd = hora del cierre.
  periodStart  DateTime
  periodEnd    DateTime
  // Fondo de caja con el que se abrió el día (usualmente $200).
  openingCash  Decimal  @db.Decimal(10, 2)
  // Ventas de caja en efectivo (no incluye liquidaciones: ese dinero ya
  // entró antes como abono).
  cashSales    Decimal  @db.Decimal(10, 2)
  // Abonos de clientes en efectivo. Van a la caja de apartados, aparte:
  // no forman parte del esperado en la caja principal.
  cashPayments Decimal  @db.Decimal(10, 2)
  // Tarjeta + transferencia (ventas y abonos); no pasa por la caja.
  bankTotal    Decimal  @db.Decimal(10, 2)
  // Caja principal: openingCash + cashSales.
  expectedCash Decimal  @db.Decimal(10, 2)
  countedCash  Decimal  @db.Decimal(10, 2)
  // countedCash − expectedCash (negativo = faltante).
  difference   Decimal  @db.Decimal(10, 2)
  notes        String?
  closedBy     String   @db.Uuid
  closedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [closedBy], references: [id])
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  Alta
  Retiro
}

enum LayawayStatus {
  Activo
  Liquidado
  Cancelado
}

enum PaymentMethod {
  Efectivo
  Tarjeta
  Transferencia
}

// Abono = el cliente deja dinero (sube su saldo). Devolucion = la tienda le
// regresa saldo a favor (baja su saldo); el monto siempre es positivo y el
// signo lo da `kind`.
enum PaymentKind {
  Abono
  Devolucion
}

// Pedido de servicio (servicios por pedido: instalaciones, mantenimientos).
// Se registra con el cliente y sus servicios, queda "PorEntregar" y se cobra
// al entregarlo: en ese momento se crea la Sale normal (saleId), que es la
// que entra al corte de caja y al corte del proveedor. Todos sus servicios
// son de un mismo proveedor; el folio es por letras del proveedor (CO-001).
model ServiceOrder {
  id                  Int                   @id @default(autoincrement())
  folio               String                @unique
  supplierId          Int
  customerName        String
  customerPhone       String?
  status              ServiceOrderStatus    @default(PorEntregar)
  createdAt           DateTime              @default(now())
  createdBy           String                @db.Uuid
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  saleId              Int?                  @unique
  Supplier            Supplier              @relation(fields: [supplierId], references: [id])
  User                User                  @relation(fields: [createdBy], references: [id])
  Sale                Sale?                 @relation(fields: [saleId], references: [id])
  ServiceOrderItem    ServiceOrderItem[]
  // Anticipos, pagos y devoluciones del pedido. Cada uno cuenta en el corte
  // de caja del día en que se recibió; la venta (saleId) se crea cuando el
  // pedido queda pagado completo, y no se vuelve a contar en caja.
  ServiceOrderPayment ServiceOrderPayment[]

  @@index([status])
}

model ServiceOrderItem {
  id           Int          @id @default(autoincrement())
  orderId      Int
  productId    Int
  description  String
  quantity     Int          @default(1)
  price        Decimal      @db.Decimal(10, 2)
  ServiceOrder ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product      Product      @relation(fields: [productId], references: [id])
}

enum ServiceOrderStatus {
  PorEntregar
  Entregado
  Cancelado
}

// Dinero de un pedido de servicio: anticipo o pago (kind = Abono) y
// devolución al cancelar (kind = Devolucion). Monto siempre positivo.
model ServiceOrderPayment {
  id           Int           @id @default(autoincrement())
  orderId      Int
  amount       Decimal       @db.Decimal(10, 2)
  method       PaymentMethod
  kind         PaymentKind   @default(Abono)
  date         DateTime      @default(now())
  receivedBy   String        @db.Uuid
  // Comprobante (tarjeta/transferencia), se adjunta en el Corte de Caja.
  receiptUrl   String?
  ServiceOrder ServiceOrder  @relation(fields: [orderId], references: [id])
  User         User          @relation(fields: [receivedBy], references: [id])

  @@index([date])
}

// Promoción de un proveedor (#34): descuento a todos sus productos durante
// unos días (startsOn y endsOn, días de la tienda, ambos inclusive). La caja
// la aplica sola; un descuento manual la reemplaza; no aplica a apartados ni
// a pedidos de servicio. Una a la vez por proveedor (no se enciman fechas).
// No se borran: se cancelan (cancelledAt).
model SupplierPromotion {
  id          Int                        @id @default(autoincrement())
  supplierId  Int
  name        String?
  type        PromotionType
  // Porcentaje (1–99) o pesos menos por pieza.
  value       Decimal                    @db.Decimal(10, 2)
  startsOn    DateTime                   @db.Date
  endsOn      DateTime                   @db.Date
  cancelledAt DateTime?
  createdAt   DateTime                   @default(now())
  createdBy   String                     @db.Uuid
  Supplier    Supplier                   @relation(fields: [supplierId], references: [id])
  User        User                       @relation(fields: [createdBy], references: [id])
  SaleItem    SaleItem[]
  // true = todos los productos del proveedor; false = sólo los de
  // SupplierPromotionProduct. Un producto no puede estar en dos promociones
  // vigentes a la vez (lo revisa POST /api/suppliers/[id]/promotions).
  allProducts Boolean                    @default(true)
  Products    SupplierPromotionProduct[]

  @@index([supplierId])
}

enum PromotionType {
  Porcentaje
  CantidadFija
}

// Productos elegidos de una promoción "sólo algunos productos".
model SupplierPromotionProduct {
  promotionId Int
  productId   Int
  Promotion   SupplierPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  Product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
}
